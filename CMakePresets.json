{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 / Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows", "BUILD_TESTING": "ON" }
    },
    {
      "name": "contracts-only",
      "displayName": "E0 contracts / no third-party libraries",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/contracts-only",
      "cacheVariables": { "CODE_XRAY_BUILD_APP": "OFF", "CODE_XRAY_BUILD_PROFILES": "OFF", "CODE_XRAY_BUILD_EXPORT": "OFF", "BUILD_TESTING": "ON" }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CODE_XRAY_BUILD_APP": "ON",
        "CODE_XRAY_BUILD_PROFILES": "ON",
        "CODE_XRAY_BUILD_EXPORT": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon / full application / Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-contracts",
      "displayName": "macOS / Clang / Contracts & Tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-contracts",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "CODE_XRAY_BUILD_APP": "OFF", "CODE_XRAY_BUILD_PROFILES": "OFF", "CODE_XRAY_BUILD_EXPORT": "OFF", "BUILD_TESTING": "ON" },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "contracts-only", "configurePreset": "contracts-only", "configuration": "Debug" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-contracts", "configurePreset": "macos-contracts", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "contracts-only", "configurePreset": "contracts-only", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "macos-contracts", "configurePreset": "macos-contracts", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
